{
  "name": "grimorio-do-mestre",
  "productName": "Grimório do Mestre",
  "version": "1.0.0",
  "description": "Organizador de campanhas e ferramentas de narração para mestres de RPG (Pathfinder 1e)",
  "main": "main.js",
  "author": "Alieto Azevedo",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "br.alieto.grimoriodomestre",
    "productName": "Grimório do Mestre",
    "copyright": "Alieto Azevedo",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "importador-notion.js",
      "zip.js",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "artifactName": "Grimorio-do-Mestre-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Grimório do Mestre",
      "language": "1046",
      "installerLanguages": ["pt_BR"]
    }
  }
}
